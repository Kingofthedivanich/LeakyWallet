ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

TELEGRAM_BOT_TOKEN=
TELEGRAM_USE_WEBHOOK=false
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

POSTGRES_USER=leakywallet
POSTGRES_PASSWORD=leakywallet
POSTGRES_DB=leakywallet

# Хосты "localhost" — для инструментов, запускаемых на хосте (pytest, alembic,
# локальный uvicorn), через проброшенные порты docker-compose. Внутри
# контейнеров app/worker эти же переменные переопределяются на "postgres"/
# "redis" (см. docker-compose.yml), чтобы использовать сетевые имена сервисов.
DATABASE_URL=postgresql+asyncpg://leakywallet:leakywallet@localhost:5432/leakywallet
REDIS_URL=redis://localhost:6379/0

FERNET_KEY=

SENTRY_DSN=
