ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

TELEGRAM_BOT_TOKEN=
TELEGRAM_USE_WEBHOOK=false
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

POSTGRES_USER=leakywallet
POSTGRES_PASSWORD=leakywallet
POSTGRES_DB=leakywallet

# Хосты "localhost" — для инструментов, запускаемых на хосте (pytest, alembic,
# локальный uvicorn), через проброшенные порты docker-compose. Внутри
# контейнеров app/worker эти же переменные переопределяются на "postgres"/
# "redis" (см. docker-compose.yml), чтобы использовать сетевые имена сервисов.
DATABASE_URL=postgresql+asyncpg://leakywallet:leakywallet@localhost:5432/leakywallet
REDIS_URL=redis://localhost:6379/0

# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Google Cloud Console -> OAuth consent screen (External, Testing) + Credentials
# -> OAuth client ID (Web application). Redirect URI должен быть добавлен туда
# ровно в таком же виде.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/callback

SENTRY_DSN=
